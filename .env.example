# ═══════════════════════════════════════════════════════════════
#  SFES Luxury — Variables de entorno
#
#  Copia este archivo como ".env" (sin .example) y completa los valores.
#  El archivo .env NUNCA debe subirse a git: ya está en .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sfes_luxury
DB_USER=root
DB_PASS=

# ── Aplicación ─────────────────────────────────────────────────
# Deja BASE_URL vacío para que se detecte sola (funciona igual en la
# raíz del dominio, en una subcarpeta de XAMPP o en un hosting).
# Solo defínela si necesitas forzar una ruta concreta.
BASE_URL=

# Zona horaria de los pedidos y los informes
APP_TIMEZONE=America/Bogota

# ── Entorno ────────────────────────────────────────────────────
# true  → muestra los errores en pantalla (desarrollo)
# false → los oculta y los escribe en storage/logs/error.log (producción)
APP_DEBUG=true

# ── Identidad de la tienda ─────────────────────────────────────
TIENDA_NOMBRE=SFES Luxury
TIENDA_EMAIL=contacto@sfesluxury.com
TIENDA_WHATSAPP=573000000000

# ── Inteligencia artificial (opcional) ─────────────────────────
# Sin estas claves el sitio funciona completo: el asistente y el
# generador de piezas responden en modo demostración.
#
# Claude — asistente del sitio y conceptos de "Personalizar con IA"
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — vista previa de imagen en "Personalizar con IA"
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
